def menu():
    print("1. Explorar")
    print("2. Ver estado")
    print("3. Tienda")
    print("4. Salir")

def juego():
    intro()

    nombre = input("Ingresa tu nombre: ")
    jugador = Personaje(nombre)

    while True:
        if jugador.vida <= 0:
            print("GAME OVER")
            break

        menu()

        opcion = input("> ")

        if opcion == "1":
            enemigo = generar_enemigo(jugador.nivel)
            resultado = combate(jugador, enemigo)

            if resultado == "derrota":
                break

            pausa()

        elif opcion == "2":
            jugador.mostrar_estado()
            pausa()

        elif opcion == "3":
            tienda(jugador)

        elif opcion == "4":
            print("Gracias por jugar.")
            break

        else:
            print("Opción inválida.")
            pausa()

        limpiar()

# ============================================
# INICIAR JUEGO
# ============================================

juego()  